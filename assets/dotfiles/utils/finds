#!/usr/bin/env bash

function lssshcfg() {
  # Params:
  # - host

  local selected_host
  local target_file="$HOME/.ssh/config"

  if [[ $# -gt 1 ]]; then
    printf 'Usage: lssshcfg [host]\n' >&2
    return 3
  elif [[ ! -f "$target_file" ]]; then
    printf 'SSH config not found: %s\n' "$target_file" >&2
    return 1
  elif [[ $# -eq 1 ]]; then
    selected_host=$1
  else
    if ! command -v fzf &> /dev/null; then
      printf 'fzf is unavailable; specify a Host as an argument.\n' >&2
      return 1
    fi
    selected_host=$(
      awk 'tolower($1) == "host" {
        for (i = 2; i <= NF; i++) if ($i !~ /[*!?]/) print $i
      }' "$target_file" | fzf --no-multi --no-preview --prompt='SSH host> '
    ) || return
  fi

  awk -v host="$selected_host" '
    tolower($1) == "host" {
      if (found) exit
      for (i = 2; i <= NF; i++) if ($i == host) found = 1
    }
    found && $0 !~ /^[[:space:]]*#/ { print }
  ' "$target_file"
}
