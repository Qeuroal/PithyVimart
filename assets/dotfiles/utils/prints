#!/usr/bin/env bash

to_upper() {
  echo "$@" | tr '[:lower:]' '[:upper:]'
}

to_lower() {
  echo "$@" | tr '[:upper:]' '[:lower:]'
}

# A locally built tput may be on PATH but unable to load its shared libraries.
# Do not export LD_LIBRARY_PATH="$HOME/.local/lib:$LD_LIBRARY_PATH" here:
# this file is sourced, so the setting would also affect other programs started
# by the shell and could make them load incompatible local libraries. The actual
# library directory also depends on the user's installation prefix. If needed,
# users can configure it themselves after verifying that directory, using
# "${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" to avoid an empty path component
# (which the Linux dynamic linker treats as the current working directory).
# For optional colors, fall back to a working tput or plain text instead.
_pithy_tput=""
if [[ -n "${TERM:-}" && "$TERM" != "dumb" ]]; then
  for _pithy_tput_candidate in tput /usr/bin/tput /bin/tput; do
    if "$_pithy_tput_candidate" sgr0 >/dev/null 2>&1; then
      _pithy_tput="$_pithy_tput_candidate"
      break
    fi
  done
fi

if [[ -n "$_pithy_tput" ]]; then
  # reset / style
  C_RESET="$("$_pithy_tput" sgr0 2>/dev/null || :)"
  C_BOLD="$("$_pithy_tput" bold 2>/dev/null || :)"
  C_UNDERLINE="$("$_pithy_tput" smul 2>/dev/null || :)"
  # foreground
  FG_BLACK="$("$_pithy_tput" setaf 0 2>/dev/null || :)"
  FG_RED="$("$_pithy_tput" setaf 1 2>/dev/null || :)"
  FG_GREEN="$("$_pithy_tput" setaf 2 2>/dev/null || :)"
  FG_YELLOW="$("$_pithy_tput" setaf 3 2>/dev/null || :)"
  FG_BLUE="$("$_pithy_tput" setaf 4 2>/dev/null || :)"
  FG_PURPLE="$("$_pithy_tput" setaf 5 2>/dev/null || :)"
  FG_CYAN="$("$_pithy_tput" setaf 6 2>/dev/null || :)"
  FG_WHITE="$("$_pithy_tput" setaf 7 2>/dev/null || :)"
  # background
  BG_BLACK="$("$_pithy_tput" setab 0 2>/dev/null || :)"
  BG_RED="$("$_pithy_tput" setab 1 2>/dev/null || :)"
  BG_GREEN="$("$_pithy_tput" setab 2 2>/dev/null || :)"
  BG_YELLOW="$("$_pithy_tput" setab 3 2>/dev/null || :)"
  BG_BLUE="$("$_pithy_tput" setab 4 2>/dev/null || :)"
  BG_PURPLE="$("$_pithy_tput" setab 5 2>/dev/null || :)"
  BG_CYAN="$("$_pithy_tput" setab 6 2>/dev/null || :)"
  BG_WHITE="$("$_pithy_tput" setab 7 2>/dev/null || :)"
else
  # no color
  C_RESET=""
  C_BOLD=""
  C_UNDERLINE=""
  # foreground
  FG_BLACK=""
  FG_RED=""
  FG_GREEN=""
  FG_YELLOW=""
  FG_BLUE=""
  FG_PURPLE=""
  FG_CYAN=""
  FG_WHITE=""
  # background
  BG_BLACK=""
  BG_RED=""
  BG_GREEN=""
  BG_YELLOW=""
  BG_BLUE=""
  BG_PURPLE=""
  BG_CYAN=""
  BG_WHITE=""
fi

unset _pithy_tput _pithy_tput_candidate

_cl_color() {
  case "$1" in
    finish)
      printf "%s" "${FG_GREEN}${C_BOLD}"
      ;;
    begin)
      printf "%s" "${FG_GREEN}${C_BOLD}"
      ;;
    opt)
      printf "%s" "${FG_YELLOW}${C_BOLD}"
      ;;
    error)
      printf "%s" "${FG_RED}${C_BOLD}"
      ;;
    warning)
      printf "%s" "${BG_YELLOW}${FG_BLACK}${C_BOLD}"
      ;;
    info)
      # printf "%s" "${FG_CYAN}${C_BOLD}"
      printf "%s" "${FG_BLUE}${C_BOLD}"
      ;;
    *)
      printf ""
      ;;
  esac
}

clprint() {
  mode="$(to_lower "$1")"
  shift
  color="$(_cl_color "$mode")"
  msg="${color}==> $*${C_RESET}"
  if [[ "$mode" == "opt" ]]; then
    printf "%b" "$msg"
  else
    printf "%b\n" "$msg"
  fi
}

bclprint() {
  mode="$(to_lower "$1")"
  shift
  color="$(_cl_color "$mode")"

  printf "%b\n" "$color"

  if [[ "$mode" == "opt" ]]; then
    echo "==> $1"
    shift
  else
    echo "==> $(to_upper "$mode") {{{"
  fi

  while [[ $# -ne 0 ]]; do
    echo "  $1"
    shift
  done

  if [[ "$mode" == "opt" ]]; then
    printf "%b" "$C_RESET"
  else
    echo "<=== }}}${C_RESET}"
    echo
  fi
}

opt_print() {
  opt="$1"
  val="$2"

  [[ -z "$opt" ]] && return

  if [[ ${#opt} -le 24 ]]; then
    printf "  %-24s%s\n" "$opt" "$val"
  else
    printf "  %-24s\n    %24s%s\n" "$opt" " " "$val"
  fi

  shift 2

  while [[ $# -ne 0 ]]; do
    printf "    %24s%s\n" " " "$1"
    shift
  done
}
