# vim:ft=bash:tw=120:et:

# getting proper colors
# export TERM="xterm-256color"

# PATH
[[ -d "$HOME/.bin" ]] \
  && export PATH="$HOME/.bin:$PATH"
[[ -d "$HOME/.local/bin" ]] \
  && export PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/.emacs.d/bin" ]] \
  && export PATH="$HOME/.emacs.d/bin:$PATH"
[[ -d "$HOME/Applications" ]] \
  && export PATH="$HOME/Applications:$PATH"
[[ -d "/var/lib/flatpak/exports/bin" ]] \
  && export PATH="/var/lib/flatpak/exports/bin:$PATH"
[[ -d "$HOME/.config/emacs/bin" ]] \
  && export PATH="$HOME/.config/emacs/bin:$PATH"
[[ -d "$HOME/.local/node/bin" ]] \
  && export PATH="$HOME/.local/node/bin:$PATH"
[[ "$(uname)" = 'Darwin' && -d "/usr/local/opt/gnu-sed/libexec/gnubin" ]] \
  && export PATH="/usr/local/opt/gnu-sed/libexec/gnubin:$PATH"
[[ "$(uname)" = 'Darwin' && -d "/usr/local/opt/gnu-tar/libexec/gnubin" ]] \
  && export PATH="/usr/local/opt/gnu-tar/libexec/gnubin:$PATH"

# Editor
[[ -z "$EDITOR" ]] && export EDITOR="nvim"
[[ -z "$VISUAL" ]] && export VISUAL="$EDITOR"

# Bash-only 配置
if [[ -n "$BASH_VERSION" ]]; then
  # ignore upper and lowercase when TAB completion
  bind "set completion-ignore-case on"

  # ctrl+v 等价于 ctrl+x ctrl+e
  bind '"\C-v": edit-and-execute-command'
fi

# Zsh-only 配置
if [[ -n "$ZSH_VERSION" ]]; then
  # 初始化 zsh 补全系统
  autoload -Uz compinit
  compinit

  # ignore upper and lowercase when TAB completion
  zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

  # 允许 >> 自动创建文件
  setopt APPEND_CREATE

  # ctrl+v 等价于 ctrl+x ctrl+e
  autoload -Uz edit-command-line
  zle -N edit-command-line
  bindkey '^V' edit-command-line
fi

