# vim:ft=bash:tw=120:et:

PITHY_DOTFILES_PATH="$HOME/.config/pithy_configs"
PITHY_CUSTOM_CONFIG_PATH="$HOME/.config/pithy_custom_config"

# WARNING: The environment variables must be imported first.
[[ -e "$PITHY_DOTFILES_PATH/.env_config" ]] && source "$PITHY_DOTFILES_PATH/.env_config"

# If not running interactively, don't do anything
if [[ $- != *i* ]]; then
  [[ -f "$PITHY_CUSTOM_CONFIG_PATH" ]] && { source "$PITHY_CUSTOM_CONFIG_PATH" || true; }
  return 0
fi

# load zshrc/bashrc
if [[ -n "$ZSH_VERSION" ]]; then
  [[ -e "$PITHY_DOTFILES_PATH/profiles/zshrc" ]] && source "$PITHY_DOTFILES_PATH/profiles/zshrc"
elif [[ -n "$BASH_VERSION" ]]; then
  [[ -e "$PITHY_DOTFILES_PATH/profiles/bashrc" ]] && source "$PITHY_DOTFILES_PATH/profiles/bashrc"
fi

# import aliases
[[ -e "$PITHY_DOTFILES_PATH/.aliases" ]] && source "$PITHY_DOTFILES_PATH/.aliases"
# import cli stack
[[ -e "$PITHY_DOTFILES_PATH/profiles/cli_stack/setup" ]] && source "$PITHY_DOTFILES_PATH/profiles/cli_stack/setup"
# import utils
[[ -e "$PITHY_DOTFILES_PATH/utils/setup" ]] && source "$PITHY_DOTFILES_PATH/utils/setup"

# load zshrc_post
if [[ -n "$ZSH_VERSION" ]]; then
  [[ -e "$PITHY_DOTFILES_PATH/profiles/zshrc_post" ]] && source "$PITHY_DOTFILES_PATH/profiles/zshrc_post"
fi

#{{{> import custom user config
# WARNING: The user environment variables must be imported last
if [[ -f "$PITHY_CUSTOM_CONFIG_PATH" ]]; then
  # `|| true`: 显示忽略用户自定义配置状态
  source "$PITHY_CUSTOM_CONFIG_PATH" || true
fi
#<}}}

# 显式返回 0, 确保整个脚本加载完的状态是绿色的
# 为保证及时纠错, 暂时关闭此模式
# return 0
