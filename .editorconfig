root = true

[*]
insert_final_newline = true
indent_style = space
tab_width = 2
charset = utf-8

[scripts/*]
tab_width = 2

[scripts/prints.sh]
tab_width = 2

[Makefile]
indent_style = tab

[assets/dotfiles/*]
tab_width = 2

[assets/dotfiles/.custom_gitconfig]
indent_style = tab

[*.md]
tab_width = 3

